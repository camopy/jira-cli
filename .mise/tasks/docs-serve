#!/usr/bin/env bash
# Serve the docs site locally with live reload.
set -euo pipefail

published_site_url="https://matcra587.github.io/jira-cli/"
local_site_url="http://localhost:8000/"
tmp_config="zensical.serve.tmp.toml"

cleanup() { rm -f "$tmp_config"; }
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM

awk -v pub="$published_site_url" -v loc="$local_site_url" '
  $0 == "site_url = \"" pub "\"" { print "site_url = \"" loc "\""; next }
  { print }
' zensical.toml > "$tmp_config"

uvx --from zensical zensical serve -f "$tmp_config" "$@"
